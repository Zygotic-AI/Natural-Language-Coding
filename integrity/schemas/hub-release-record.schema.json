{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "version", "release_branch", "prepare_head"],
  "properties": {
    "schema": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_branch": { "type": "string", "pattern": "^release/v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "prepare_head": { "type": "string", "minLength": 7 }
  },
  "additionalProperties": true
}
