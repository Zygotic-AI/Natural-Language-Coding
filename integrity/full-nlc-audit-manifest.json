    },
    "jobs-todo-sync": {
      "blocking": true,
      "label": "JOBS vs TODO sync",
      "command": ["python3", "tools/fitness-jobs-todo-sync.py"],
      "pass_substrings": ["RESULT:MET"]
    },
    "adr-0038-no-memory": {
      "blocking": true,
      "label": "ADR 0038 operator prose",
      "command": ["python3", "tools/fitness-adr-0038-no-memory.py"],
      "pass_substrings": ["RESULT:MET"]
    },
    "adr-enforcement-continuity": {
