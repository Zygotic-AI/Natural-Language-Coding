    "verify-deep": {
      "blocking": true,
      "label": "Hub verify-deep (ci_fitness + blockers)",
      "command": ["./nlc", "verify-deep"],
      "pass_substrings": ["Verify-deep passed", "CI:MET"]
    },
    "verify": {
      "blocking": true,
      "label": "Hub verify (fingerprints)",
      "command": ["./nlc", "verify"],
      "pass_substrings": ["Verify passed"]
