      "pass_substrings": ["RESULT:MET"]
    },
    "findings-last-pass-fresh": {
      "blocking": true,
      "label": "FINDINGS last_pass_sha matches HEAD (F2)",
      "command": ["python3", "tools/fitness-findings-last-pass-fresh.py"],
      "pass_substrings": ["RESULT:MET"]
