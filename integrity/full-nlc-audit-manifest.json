    "git-worktree-clean": {
      "blocking": true,
      "label": "Git working tree clean (full profile)",
      "builtin": "git_worktree_clean"
    },
    "release-preflight": {
      "blocking": true,
      "label": "Release preflight (ADR 0022)",
